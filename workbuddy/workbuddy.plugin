#!name = WorkBuddy签到
#!desc = WorkBuddy 每日自动签到。登录一次后自动抓取 Cookie/Token，每天定时重放签到接口；需先在插件里填「签到接口URL」（F12 抓包，详见 README）。
#!author = binasi
#!homepage = https://github.com/binasi/loon
#!tag = 签到
#!loon_version = 3.5.1(978)

[Argument]
sign_url = input,"",tag=签到接口URL,desc=必填：登录 WorkBuddy 后 F12 → Network 点一次「签到」→ 复制接口完整 URL（如 https://xxx.workbuddy.cn/api/user/signin）
sign_method = select,POST,GET,tag=请求方法,desc=抓包到的签到请求方法，默认 POST
auth_mode = select,cookie,token,tag=认证方式,desc=cookie=完整 Cookie 串；token=Authorization Bearer
auth_value = input,"",tag=认证值(选填),desc=留空自动使用抓取脚本保存的 Cookie/Token；也可直接粘贴
extra_headers = input,"",tag=额外请求头(JSON),desc=选填：接口需要签名/风控头时填，如 {"x-device-id":"abc123"}（用你的真实值）
body = input,"",tag=请求体(选填),desc=POST 时原样发送；留空则不发送 body
cron = input,"0 9 * * *",tag=签到时间,desc=Cron 表达式，默认每天 09:00（Asia/Shanghai）
debug = switch,false,tag=调试模式,desc=记录请求与响应详情到日志

[Script]
cron ${cron} then script("https://raw.githubusercontent.com/binasi/loon/main/workbuddy/workbuddy.js", {${sign_url}, ${sign_method}, ${auth_mode}, ${auth_value}, ${extra_headers}, ${body}, ${debug}}) with tag="WorkBuddy签到", timeout=120
request if ${url} ~= /(^|\.)(workbuddy\.(cn|ai|link)|codebuddy\.cn)(:\d+)?\/api\//i then script("https://raw.githubusercontent.com/binasi/loon/main/workbuddy/workbuddy.cookie.js") with tag="WorkBuddy认证抓取", timeout=20